[Unit]
Description=CATS UDP listener: writes each token-prefixed datagram to the response bucket
StartLimitIntervalSec=0

[Service]
# Bucket, receipt token and ports are the only per-listener values; they arrive through
# the env file the instance's user data writes, so this unit is identical on every
# listener and the template embeds it once. systemd reads the file as root before
# dropping to the dynamic user, so the token never sits in a world-readable unit file,
# and the script reads it from the environment rather than argv, so it is not in `ps` output.
# Variables are unbraced: the braced form is Fn::Sub syntax in the template.
EnvironmentFile=/etc/cats/udpserver.env
ExecStart=/usr/bin/python3 -u /usr/local/bin/udpserver $CATS_BUCKET $CATS_UDP_PORTS
Restart=always
RestartSec=1
DynamicUser=yes
# A dynamic user has no passwd entry and no home. The AWS CLI resolves Path.home() at import
# and dies with "getpwuid(): uid not found" without one, so the unit gets a state directory
# of its own (writable under ProtectSystem=strict) and HOME points at it.
StateDirectory=cats-udpserver
Environment=HOME=/var/lib/cats-udpserver
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
