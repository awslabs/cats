[Unit]
Description=CATS TCP listener: answers any connection with an empty 200 OK
StartLimitIntervalSec=0

[Service]
# The port list is the only per-listener value; it arrives through the env file the
# instance's user data writes, so this unit is identical on every listener and the
# template embeds it once. systemd reads the file as root before dropping to the
# dynamic user. Variables are unbraced: the braced form is Fn::Sub syntax in the template.
EnvironmentFile=/etc/cats/tcpserver.env
ExecStart=/usr/bin/python3 -u /usr/local/bin/tcpserver $CATS_TCP_PORTS
Restart=always
RestartSec=1
DynamicUser=yes
# A dynamic user has no passwd entry and no home. The AWS CLI resolves Path.home() at import
# and dies with "getpwuid(): uid not found" without one, so the unit gets a state directory
# of its own (writable under ProtectSystem=strict) and HOME points at it.
StateDirectory=cats-tcpserver
Environment=HOME=/var/lib/cats-tcpserver
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
